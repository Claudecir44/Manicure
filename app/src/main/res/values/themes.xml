<resources>
    <style name="Theme.Manicure" parent="Theme.MaterialComponents.NoActionBar">
        <item name="corDestaque">@color/rosa</item>
        <item name="corDestaqueClaro">@color/rosa_claro</item>
        <item name="corDestaqueEscuro">@color/rosa_escuro</item>
        <item name="corTextoBotao">@color/branco</item>
        <item name="colorPrimary">@color/rosa</item>
        <item name="colorPrimaryVariant">@color/rosa_escuro</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorSecondary">@color/rosa</item>
        <item name="colorSecondaryVariant">@color/rosa_escuro</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:textColorHint">@color/dica</item>
        <item name="materialAlertDialogTheme">@style/Theme.Manicure.Dialogo</item>
    </style>

    <!-- Telas da profissional (painel, perfil, agenda): verde neon. -->
    <style name="Theme.Manicure.Profissional">
        <item name="corDestaque">@color/verde_neon</item>
        <item name="corDestaqueClaro">@color/verde_neon_claro</item>
        <item name="corDestaqueEscuro">@color/verde_neon_escuro</item>
        <item name="corTextoBotao">@color/preto</item>
        <item name="colorPrimary">@color/verde_neon</item>
        <item name="colorPrimaryVariant">@color/verde_neon_escuro</item>
        <item name="colorOnPrimary">@color/preto</item>
        <item name="colorSecondary">@color/verde_neon</item>
        <item name="colorSecondaryVariant">@color/verde_neon_escuro</item>
        <item name="colorOnSecondary">@color/preto</item>
    </style>

    <style name="Theme.Manicure.Dialogo" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">?attr/corDestaque</item>
        <item name="colorSurface">@color/superficie_alta</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorHint">@color/dica</item>
    </style>

    <!-- Campo de formulário escuro com cantos arredondados. -->
    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/dica</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="BotaoPrimario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_botao_primario</item>
        <item name="android:textColor">?attr/corTextoBotao</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <!-- Sem isso o MaterialButton pinta por cima do background próprio. -->
        <item name="backgroundTint">@null</item>
    </style>

    <style name="BotaoContorno" parent="BotaoPrimario">
        <item name="android:background">@drawable/bg_botao_contorno</item>
        <item name="android:textColor">?attr/corDestaque</item>
    </style>

    <style name="TituloSecao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">?attr/corDestaque</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoCorpo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="BotaoPainel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_cartao</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ChipFiltro" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_fundo</item>
        <item name="android:textColor">@color/chip_texto</item>
    </style>
    <!-- Linha fina que separa o mapa do topo e do rodapé. -->
    <style name="LinhaDivisoria">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/corDestaque</item>
        <item name="android:alpha">0.6</item>
    </style>

    <!-- Título pequeno acima de um campo do formulário. -->
    <style name="RotuloCampo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Cartão grande da tela de escolha (Sou profissional / Sou cliente). -->
    <style name="CartaoEscolha">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/bg_cartao</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CartaoEscolhaTitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/corDestaque</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CartaoEscolhaTexto" parent="TextoCorpo">
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Opcao">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:buttonTint">?attr/corDestaque</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Campo de texto longo (apresentação, sobre o trabalho). -->
    <style name="CampoLongo" parent="Campo">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">110dp</item>
        <item name="android:gravity">top</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
    </style>

    <!-- Botão pequeno de contato no perfil público. -->
    <style name="BotaoContato">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_botao_contorno</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/corDestaque</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

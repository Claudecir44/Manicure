<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/topo"
            layout="@layout/include_topo" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvProfissional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/corDestaque"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVazio"
                    style="@style/TextoCorpo"
                    android:layout_marginTop="20dp"
                    android:text="@string/agendar_vazio"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/blocoEscolha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TituloSecao"
                        android:text="@string/agendar_com_quem" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgAgendas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/TituloSecao"
                        android:text="@string/agendar_dia" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgDias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true" />
                    </HorizontalScrollView>

                    <TextView
                        style="@style/TituloSecao"
                        android:text="@string/agendar_horario" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgHorarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvResumo"
                        style="@style/TextoCorpo"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/texto" />

                    <Button
                        android:id="@+id/btnConfirmar"
                        style="@style/BotaoPrimario"
                        android:layout_marginTop="16dp"
                        android:text="@string/agendar_confirmar" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/corDestaque"
        android:visibility="gone" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Foto da cliente (tocar abre o Meu perfil). -->
        <ImageView
            android:id="@+id/ivFotoCliente"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_foto_anel"
            android:contentDescription="@string/cliente_editar_perfil"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pessoa" />

        <TextView
            android:id="@+id/tvOla"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/texto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/chat"
            layout="@layout/include_botao_chat" />

        <TextView
            android:id="@+id/btnSair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/sair"
            android:textColor="?attr/corDestaque"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/etBusca"
        style="@style/Campo"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:hint="@string/cliente_busca_dica"
        android:imeOptions="actionSearch"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMeusHorarios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="6dp"
            android:text="@string/meus_horarios_link"
            android:textColor="?attr/corDestaque"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMeuPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:padding="6dp"
            android:text="@string/cliente_editar_perfil"
            android:textColor="?attr/corDestaque"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/cliente_tenho_codigo"
            android:textColor="?attr/corDestaque"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfissionais"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tvVazio"
            style="@style/TextoCorpo"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/cliente_vazio"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:indeterminateTint="?attr/corDestaque" />
    </FrameLayout>
</LinearLayout>

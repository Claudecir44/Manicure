<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Topo com brilho: saudação, sair, foto, nome, tipo, código e situação. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="26dp">

                <!-- Foto no alto, saudação à esquerda e Sair + código à direita. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Saudação e, logo abaixo, o botão Aparência (cor do app). -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSaudacao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxWidth="110dp"
                            android:maxLines="2"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/btnAparencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_pilula_destaque"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_paleta" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/aparencia_botao"
                                android:textColor="?attr/corDestaque"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivFoto"
                        android:layout_width="116dp"
                        android:layout_height="116dp"
                        android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/bg_foto_anel"
                        android:contentDescription="@string/painel_meu_perfil"
                        android:padding="5dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pessoa" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/btnSair"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:padding="8dp"
                            android:text="@string/sair"
                            android:textColor="?attr/corDestaque"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCodigo"
                            style="@style/Pilula"
                            android:background="@drawable/bg_pilula_destaque"
                            android:textColor="?attr/corDestaque"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="@color/texto"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTipo"
                    style="@style/Pilula"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvSituacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Contadores. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_cartao"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvQtdServicos"
                            style="@style/ContadorNumero" />

                        <TextView
                            style="@style/ContadorRotulo"
                            android:text="@string/painel_qtd_servicos" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/borda" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvQtdFotos"
                            style="@style/ContadorNumero" />

                        <TextView
                            style="@style/ContadorRotulo"
                            android:text="@string/painel_qtd_fotos" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/borda" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvQtdCategorias"
                            style="@style/ContadorNumero" />

                        <TextView
                            style="@style/ContadorRotulo"
                            android:text="@string/painel_qtd_categorias" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Minha agenda: o atalho principal. -->
                <LinearLayout
                    android:id="@+id/btnAgenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_cartao_destaque"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_icone_escuro"
                        android:importantForAccessibility="no"
                        android:padding="13dp"
                        android:src="@drawable/ic_agenda"
                        app:tint="?attr/corTextoBotao" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/painel_minha_agenda"
                            android:textColor="?attr/corTextoBotao"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/painel_agenda_sub"
                            android:textColor="?attr/corTextoBotao"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_seta"
                        app:tint="?attr/corTextoBotao" />
                </LinearLayout>

                <!-- Atalhos em grade 2x2. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnMeuPerfil"
                        style="@style/CartaoAcao"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            style="@style/CartaoAcaoIcone"
                            android:src="@drawable/ic_editar" />

                        <TextView
                            style="@style/CartaoAcaoTitulo"
                            android:text="@string/painel_meu_perfil" />

                        <TextView
                            style="@style/CartaoAcaoTexto"
                            android:text="@string/painel_meu_perfil_sub" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnAbrirChat"
                        style="@style/CartaoAcao"
                        android:layout_marginStart="6dp">

                        <!-- Ícone de chat com o número de não lidas. -->
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_icone_destaque">

                            <include
                                android:id="@+id/chat"
                                layout="@layout/include_botao_chat"
                                android:layout_width="44dp"
                                android:layout_height="44dp" />
                        </FrameLayout>

                        <TextView
                            style="@style/CartaoAcaoTitulo"
                            android:text="@string/chat_titulo" />

                        <TextView
                            style="@style/CartaoAcaoTexto"
                            android:text="@string/painel_chat_sub" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnVerComoCliente"
                        style="@style/CartaoAcao"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            style="@style/CartaoAcaoIcone"
                            android:src="@drawable/ic_olho" />

                        <TextView
                            style="@style/CartaoAcaoTitulo"
                            android:text="@string/painel_ver_como_cliente" />

                        <TextView
                            style="@style/CartaoAcaoTexto"
                            android:text="@string/painel_ver_cliente_sub" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCompartilhar"
                        style="@style/CartaoAcao"
                        android:layout_marginStart="6dp">

                        <ImageView
                            style="@style/CartaoAcaoIcone"
                            android:src="@drawable/ic_compartilhar" />

                        <TextView
                            style="@style/CartaoAcaoTitulo"
                            android:text="@string/painel_compartilhar" />

                        <TextView
                            style="@style/CartaoAcaoTexto"
                            android:text="@string/painel_divulgar_sub" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quanto do perfil está preenchido; tocar abre o Meu perfil. -->
                <LinearLayout
                    android:id="@+id/cartaoCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_cartao"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCompleto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        app:indicatorColor="?attr/corDestaque"
                        app:trackColor="@color/superficie_alta"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/tvCompletoDica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Configurações: instruções do app, termos e ajuda. -->
                <LinearLayout
                    android:id="@+id/btnConfiguracoes"
                    style="@style/LinhaConfig"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="0dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_icone_destaque"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_config" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CartaoAcaoTitulo"
                            android:text="@string/config_titulo" />

                        <TextView
                            style="@style/CartaoAcaoTexto"
                            android:text="@string/config_sub" />
                    </LinearLayout>

                    <TextView style="@style/LinhaConfigSeta" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

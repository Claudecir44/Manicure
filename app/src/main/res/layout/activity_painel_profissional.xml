<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Chat (com mensagens não lidas) e Sair. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/chat"
                    layout="@layout/include_botao_chat" />

                <TextView
                    android:id="@+id/btnSair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="@string/sair"
                    android:textColor="?attr/corDestaque"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cabeçalho: foto (tocar troca), nome, tipo, código e situação. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFoto"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_foto_redonda"
                    android:contentDescription="@string/painel_trocar_foto"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_pessoa" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCodigo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/corDestaque"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSituacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnEditarPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:text="@string/painel_editar_perfil"
                android:textColor="?attr/corDestaque"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVerComoCliente"
                    style="@style/BotaoContorno"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/painel_ver_como_cliente"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnCompartilhar"
                    style="@style/BotaoPrimario"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/painel_compartilhar"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Categorias de serviço e agenda mensal de cada uma. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TituloSecao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/painel_categorias" />

                <TextView
                    android:id="@+id/btnCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="6dp"
                    android:text="@string/painel_editar_categorias"
                    android:textColor="?attr/corDestaque"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCategorias"
                style="@style/TextoCorpo" />

            <Button
                android:id="@+id/btnAgenda"
                style="@style/BotaoPrimario"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/painel_minha_agenda" />

            <TextView
                style="@style/TituloSecao"
                android:text="@string/painel_apresentacao" />

            <TextView
                android:id="@+id/tvApresentacao"
                style="@style/TextoCorpo" />

            <TextView
                style="@style/TituloSecao"
                android:text="@string/painel_sobre_trabalho" />

            <TextView
                android:id="@+id/tvSobreTrabalho"
                style="@style/TextoCorpo" />

            <TextView
                android:id="@+id/tvContatos"
                style="@style/TextoCorpo"
                android:layout_marginTop="12dp" />

            <!-- Serviços: tocar edita, segurar remove. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TituloSecao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/painel_servicos" />

                <TextView
                    android:id="@+id/btnAdicionarServico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="6dp"
                    android:text="@string/painel_adicionar_servico"
                    android:textColor="?attr/corDestaque"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSemServicos"
                style="@style/TextoCorpo"
                android:text="@string/painel_sem_servicos" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvServicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Galeria: até 20 fotos; segurar uma foto remove. -->
            <TextView
                android:id="@+id/tvTituloGaleria"
                style="@style/TituloSecao" />

            <TextView
                style="@style/TextoCorpo"
                android:layout_marginBottom="8dp"
                android:text="@string/painel_galeria_dica"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/corDestaque"
        android:visibility="gone" />
</FrameLayout>

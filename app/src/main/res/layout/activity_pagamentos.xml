<?xml version="1.0" encoding="utf-8"?>
<!-- Pagamentos da profissional: situação da assinatura, planos, agenda extra
     e histórico. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/topo"
        layout="@layout/include_topo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- Situação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cartao_destaque"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvStatusTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/corTextoBotao"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusDias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/corTextoBotao"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusFim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/corTextoBotao"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAgendas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="?attr/corTextoBotao"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/vermelho"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Planos -->
            <TextView
                style="@style/TituloSecao"
                android:text="@string/pag_planos" />

            <LinearLayout
                android:id="@+id/cardBasico"
                style="@style/CartaoPlano">

                <TextView
                    style="@style/CartaoPlanoNome"
                    android:text="@string/pag_basico" />

                <TextView
                    android:id="@+id/tvPrecoBasico"
                    style="@style/CartaoPlanoPreco" />

                <TextView
                    style="@style/TextoCorpo"
                    android:text="@string/pag_basico_desc" />

                <Button
                    android:id="@+id/btnBasico"
                    style="@style/BotaoPrimario"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/pag_assinar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPlus"
                style="@style/CartaoPlano">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CartaoPlanoNome"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/pag_plus" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pilula_destaque"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/pag_plus_selo"
                        android:textColor="?attr/corDestaque"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPrecoPlus"
                    style="@style/CartaoPlanoPreco" />

                <TextView
                    style="@style/TextoCorpo"
                    android:text="@string/pag_plus_desc" />

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/BotaoPrimario"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/pag_assinar" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRenovar"
                style="@style/TextoCorpo"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Agenda extra -->
            <TextView
                style="@style/TituloSecao"
                android:text="@string/pag_extra_titulo" />

            <LinearLayout style="@style/CartaoPlano">

                <TextView
                    android:id="@+id/tvPrecoExtra"
                    style="@style/CartaoPlanoPreco"
                    android:layout_marginTop="0dp" />

                <TextView
                    style="@style/TextoCorpo"
                    android:text="@string/pag_extra_desc" />

                <Button
                    android:id="@+id/btnExtra"
                    style="@style/BotaoContorno"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/pag_extra_comprar" />
            </LinearLayout>

            <!-- Como funciona -->
            <TextView
                style="@style/TituloSecao"
                android:text="@string/pag_como_funciona" />

            <TextView
                style="@style/TextoCorpo"
                android:text="@string/pag_regras" />

            <!-- Histórico -->
            <TextView
                style="@style/TituloSecao"
                android:text="@string/pag_historico" />

            <TextView
                android:id="@+id/tvSemHistorico"
                style="@style/TextoCorpo"
                android:text="@string/pag_sem_historico" />

            <LinearLayout
                android:id="@+id/llHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="?attr/corDestaque"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

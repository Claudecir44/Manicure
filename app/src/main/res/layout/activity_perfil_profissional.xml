<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/topo"
        layout="@layout/include_topo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivFoto"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_foto_redonda"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pessoa" />

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/corDestaque"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPreferido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/perfil_preferido"
                android:textColor="?attr/corDestaqueClaro"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Contatos: só aparecem os que ela preencheu. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnChat"
                    style="@style/BotaoContato"
                    android:text="@string/perfil_chat" />

                <TextView
                    android:id="@+id/btnLigar"
                    style="@style/BotaoContato"
                    android:text="@string/perfil_ligar" />

                <TextView
                    android:id="@+id/btnInstagram"
                    style="@style/BotaoContato"
                    android:text="@string/perfil_instagram" />

                <TextView
                    android:id="@+id/btnMapa"
                    style="@style/BotaoContato"
                    android:text="@string/perfil_mapa" />
            </LinearLayout>

            <!-- Agendar: uma opção por categoria com horário livre. -->
            <LinearLayout
                android:id="@+id/blocoAgendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TituloSecao"
                    android:text="@string/perfil_agendar" />

                <!-- Lembrete do horário que a cliente já marcou aqui. -->
                <LinearLayout
                    android:id="@+id/blocoLembrete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_botao_contorno"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_lembrete_titulo"
                        android:textColor="?attr/corDestaque"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLembrete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/texto"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvCancelarHorario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:padding="4dp"
                        android:text="@string/agendar_cancelar_titulo"
                        android:textColor="@color/vermelho"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blocoApresentacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloSecao"
                    android:text="@string/perfil_apresentacao" />

                <TextView
                    android:id="@+id/tvApresentacao"
                    style="@style/TextoCorpo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blocoServicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloSecao"
                    android:text="@string/perfil_servicos" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvServicos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blocoGaleria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloSecao"
                    android:text="@string/perfil_galeria" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blocoSobre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloSecao"
                    android:text="@string/perfil_sobre_trabalho" />

                <TextView
                    android:id="@+id/tvSobreTrabalho"
                    style="@style/TextoCorpo" />
            </LinearLayout>

            <TextView
                style="@style/TituloSecao"
                android:text="@string/perfil_contatos" />

            <TextView
                android:id="@+id/tvContatos"
                style="@style/TextoCorpo"
                android:textIsSelectable="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

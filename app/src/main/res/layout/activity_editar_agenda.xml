<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/topo"
        layout="@layout/include_topo" />

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/RotuloCampo"
                android:text="@string/agenda_categoria" />

            <Spinner
                android:id="@+id/spCategoria"
                style="@style/Campo"
                android:paddingStart="8dp" />

            <TextView
                style="@style/RotuloCampo"
                android:text="@string/agenda_mes" />

            <Spinner
                android:id="@+id/spMes"
                style="@style/Campo"
                android:paddingStart="8dp" />

            <TextView
                style="@style/RotuloCampo"
                android:text="@string/agenda_atendente" />

            <EditText
                android:id="@+id/etAtendente"
                style="@style/Campo"
                android:hint="@string/agenda_atendente_dica"
                android:layout_marginBottom="4dp"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/TextoCorpo"
                android:layout_marginBottom="12dp"
                android:text="@string/agenda_atendente_regra"
                android:textSize="12sp" />

            <TextView
                style="@style/RotuloCampo"
                android:text="@string/agenda_dias" />

            <TextView
                style="@style/TextoCorpo"
                android:layout_marginBottom="6dp"
                android:text="@string/agenda_dias_dica"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="0dp" />

            <TextView
                android:id="@+id/tvContadorDias"
                style="@style/TextoCorpo"
                android:layout_marginBottom="14dp"
                android:textColor="?attr/corDestaque"
                android:textSize="12sp" />

            <!-- Horários de cada dia + lembrete pra ajustar. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agenda_horarios"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_botao_contorno"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="@string/agenda_lembrete_ajuste"
                    android:textColor="?attr/corDestaque"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etInicio"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="@string/agenda_inicio"
                    android:inputType="time"
                    android:text="09:00" />

                <EditText
                    android:id="@+id/etFim"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="@string/agenda_fim"
                    android:inputType="time"
                    android:text="18:00" />

                <EditText
                    android:id="@+id/etIntervalo"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/agenda_intervalo"
                    android:inputType="number"
                    android:text="60" />
            </LinearLayout>

            <TextView
                style="@style/TextoCorpo"
                android:layout_marginBottom="8dp"
                android:text="@string/agenda_horarios_dica"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGerar"
                style="@style/BotaoContorno"
                android:layout_height="44dp"
                android:text="@string/agenda_aplicar" />

            <TextView
                android:id="@+id/tvSemHorarios"
                style="@style/TextoCorpo"
                android:layout_marginTop="10dp"
                android:text="@string/agenda_sem_horarios" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgHorarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnAjustarDia"
                style="@style/BotaoContorno"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="@string/agenda_ajustar_dia" />

            <Button
                android:id="@+id/btnSalvar"
                style="@style/BotaoPrimario"
                android:text="@string/agenda_salvar" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="?attr/corDestaque"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

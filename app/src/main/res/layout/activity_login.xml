<?xml version="1.0" encoding="utf-8"?>
<!-- Login (profissional e cliente) com o botão Suporte no canto de baixo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

<ScrollView
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_manicure" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrocarPapel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:padding="6dp"
            android:text="@string/login_trocar_papel"
            android:textColor="?attr/corDestaque"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/Campo"
            android:autofillHints="emailAddress"
            android:hint="@string/email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/etSenha"
            style="@style/Campo"
            android:autofillHints="password"
            android:hint="@string/senha"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/tvEsqueciSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="20dp"
            android:padding="6dp"
            android:text="@string/login_esqueci_senha"
            android:textColor="?attr/corDestaque"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEntrar"
            style="@style/BotaoPrimario"
            android:text="@string/entrar" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="?attr/corDestaque"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCriarConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="@string/login_criar_conta"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <!-- Espaço pro botão Suporte não cobrir o "Criar conta". -->
        <View
            android:layout_width="match_parent"
            android:layout_height="56dp" />
    </LinearLayout>
</ScrollView>

    <TextView
        android:id="@+id/tvSuporte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_botao_contorno"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/suporte_botao"
        android:textColor="?attr/corDestaque"
        android:textSize="13sp"
        android:textStyle="bold" />
</FrameLayout>

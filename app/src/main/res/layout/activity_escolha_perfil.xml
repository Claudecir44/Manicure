<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_manicure" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:text="@string/escolha_titulo"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardProfissional"
            style="@style/CartaoEscolha">

            <TextView
                style="@style/CartaoEscolhaTitulo"
                android:text="@string/escolha_profissional" />

            <TextView
                style="@style/CartaoEscolhaTexto"
                android:text="@string/escolha_profissional_texto" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardCliente"
            style="@style/CartaoEscolha">

            <TextView
                style="@style/CartaoEscolhaTitulo"
                android:text="@string/escolha_cliente" />

            <TextView
                style="@style/CartaoEscolhaTexto"
                android:text="@string/escolha_cliente_texto" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/topo"
        layout="@layout/include_topo" />

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etNome"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:hint="@string/admin_nome"
                    android:inputType="textPersonName|textCapWords" />

                <EditText
                    android:id="@+id/etSobrenome"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/admin_sobrenome"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <EditText
                android:id="@+id/etCpf"
                style="@style/Campo"
                android:hint="@string/cpf"
                android:inputType="number" />

            <EditText
                android:id="@+id/etTelefone"
                style="@style/Campo"
                android:hint="@string/telefone"
                android:inputType="phone" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/Campo"
                android:hint="@string/email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/etSenha"
                style="@style/Campo"
                android:hint="@string/senha"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/etConfirmarSenha"
                style="@style/Campo"
                android:hint="@string/confirmar_senha"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/tvPapel"
                style="@style/TituloSecao"
                android:text="@string/admin_papel" />

            <RadioGroup
                android:id="@+id/rgPapel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@+id/rbAdmin">

                <RadioButton
                    android:id="@+id/rbAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/corDestaque"
                    android:text="@string/admin_papel_admin"
                    android:textColor="@color/texto" />

                <RadioButton
                    android:id="@+id/rbColaborador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/corDestaque"
                    android:text="@string/admin_papel_colaborador"
                    android:textColor="@color/texto" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/containerPermissoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                style="@style/TituloSecao"
                android:text="@string/admin_senha_master" />

            <TextView
                android:id="@+id/tvSenhaMasterDica"
                style="@style/TextoCorpo"
                android:layout_marginBottom="10dp"
                android:text="@string/admin_senha_master_dica" />

            <EditText
                android:id="@+id/etSenhaMaster"
                style="@style/Campo"
                android:hint="@string/admin_senha_master"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnCadastrar"
                style="@style/BotaoPrimario"
                android:layout_marginTop="12dp"
                android:text="@string/admin_cadastrar" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="?attr/corDestaque"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

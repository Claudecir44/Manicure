<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/topo"
        layout="@layout/include_topo" />

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvExplicacao"
                style="@style/TextoCorpo"
                android:layout_marginBottom="20dp" />

            <!-- Só no cadastro da cliente: foto obrigatória (tocar escolhe). -->
            <LinearLayout
                android:id="@+id/blocoFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btnFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivFoto"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:background="@drawable/bg_foto_anel"
                        android:contentDescription="@string/cadastro_foto_dica"
                        android:padding="5dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pessoa" />

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_selo_camera"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera"
                        app:tint="?attr/corTextoBotao" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFotoDica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cadastro_foto_dica"
                    android:textColor="?attr/corDestaque"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etNome"
                style="@style/Campo"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/etTelefone"
                style="@style/Campo"
                android:hint="@string/telefone"
                android:inputType="phone" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/Campo"
                android:autofillHints="emailAddress"
                android:hint="@string/email"
                android:inputType="textEmailAddress" />

            <LinearLayout
                android:id="@+id/blocoConta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etSenha"
                    style="@style/Campo"
                    android:hint="@string/senha_nova"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/etConfirmarSenha"
                    style="@style/Campo"
                    android:hint="@string/senha_confirmar"
                    android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbTermos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/corDestaque" />

                <TextView
                    android:id="@+id/tvTermos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="4dp"
                    android:text="@string/cadastro_aceito_termos"
                    android:textColor="?attr/corDestaque"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCadastrar"
                style="@style/BotaoPrimario"
                android:text="@string/cadastro_criar" />

            <TextView
                android:id="@+id/tvLimpar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:text="@string/cadastro_limpar"
                android:textColor="?attr/corDestaque"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="?attr/corDestaque"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

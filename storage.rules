rules_version = '2';

// Fotos de perfil e da galeria: qualquer usuário logado vê (as clientes
// abrem o perfil das profissionais); só a dona grava na própria pasta, então
// uma profissional nunca altera as fotos de outra.
//
// Sem firestore.exists() aqui de propósito (mesmo motivo do Start: a
// organização desliga a concessão automática que o Storage precisaria).
service firebase.storage {
  match /b/{bucket}/o {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function imagemValida() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }

    match /perfis/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if dono(uid) && (request.resource == null || imagemValida());
    }

    match /portfolio/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if dono(uid) && (request.resource == null || imagemValida());
    }

    match /fotos_admin/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if dono(uid) && (request.resource == null || imagemValida());
    }
  }
}

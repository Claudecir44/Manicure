rules_version = '2';

// Regras do Manicure (profissional, cliente e admin no mesmo projeto).
// Princípio: cada profissional grava só o próprio perfil — uma nunca mexe no
// da outra; as clientes só leem perfis publicados e não bloqueados. Bloqueio
// só o admin muda. Admins vêm SÓ da Cloud Function cadastrarAdmin.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function dono(uid) {
      return logado() && request.auth.uid == uid;
    }

    function ehAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function permissaoAdmin(chave) {
      let dados = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return dados.cpf == '56413025034'
        || !('permissoes' in dados)
        || dados.permissoes == null
        || dados.permissoes.get(chave, false) == true;
    }

    function alterados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Galeria com no máximo 20 fotos e até 30 serviços.
    function limites(d) {
      return d.fotos is list && d.fotos.size() <= 20
        && d.servicos is list && d.servicos.size() <= 30;
    }

    // ===== Profissionais =====
    match /profissionais/{uid} {
      // Cliente logada vê perfis publicados; a dona e o admin veem sempre.
      allow read: if (logado() && resource.data.publicado == true && resource.data.bloqueado == false)
        || dono(uid)
        || (ehAdmin() && permissaoAdmin('profissionais'));
      allow create: if dono(uid)
        && request.resource.data.bloqueado == false
        && request.resource.data.fotos.size() == 0
        && limites(request.resource.data);
      allow update: if (dono(uid)
          && resource.data.bloqueado == false
          && !alterados().hasAny(['bloqueado', 'email', 'codigo', 'criadoEm'])
          && limites(request.resource.data))
        || (ehAdmin() && permissaoAdmin('profissionais') && alterados().hasOnly(['bloqueado']));
      allow delete: if false;
    }

    // ===== Agendas mensais da profissional =====
    // Qualquer usuário logado lê (a cliente vê os horários livres; os
    // "ocupados" são só chaves de horário, sem nome de quem marcou).
    match /profissionais/{uid}/agendas/{agendaId} {
      allow read: if logado();
      allow create, delete: if dono(uid);
      allow update: if dono(uid)
        // Cliente reservando: só acrescenta UM horário livre aos ocupados,
        // e a marcação correspondente é criada no mesmo lote.
        || (logado() && !dono(uid)
          && alterados().hasOnly(['ocupados', 'ultimoReservado'])
          && request.resource.data.ultimoReservado is string
          && !(request.resource.data.ultimoReservado in resource.data.ocupados)
          && request.resource.data.ocupados == resource.data.ocupados.concat([request.resource.data.ultimoReservado])
          && existsAfter(/databases/$(database)/documents/profissionais/$(uid)/agendamentos/$(agendaId + '_' + request.resource.data.ultimoReservado)))
        // Cliente desmarcando: tira UM horário dos ocupados, que era dela,
        // e a marcação é apagada no mesmo lote.
        || (logado() && !dono(uid)
          && alterados().hasOnly(['ocupados', 'ultimoLiberado'])
          && request.resource.data.ultimoLiberado is string
          && request.resource.data.ultimoLiberado in resource.data.ocupados
          && request.resource.data.ocupados == resource.data.ocupados.removeAll([request.resource.data.ultimoLiberado])
          && get(/databases/$(database)/documents/profissionais/$(uid)/agendamentos/$(agendaId + '_' + request.resource.data.ultimoLiberado)).data.clienteId == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/profissionais/$(uid)/agendamentos/$(agendaId + '_' + request.resource.data.ultimoLiberado)));
    }

    // ===== Horários marcados =====
    // A profissional vê todos; a cliente só o próprio.
    match /profissionais/{uid}/agendamentos/{id} {
      allow read: if dono(uid) || (logado() && resource.data.clienteId == request.auth.uid);
      allow create: if logado()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.profissionalId == uid
        && id == request.resource.data.agendaId + '_' + request.resource.data.horario
        && getAfter(/databases/$(database)/documents/profissionais/$(uid)/agendas/$(request.resource.data.agendaId)).data.ultimoReservado == request.resource.data.horario;
      allow update: if false;
      // A profissional cancela; a cliente desmarca o próprio horário.
      allow delete: if dono(uid) || (logado() && resource.data.clienteId == request.auth.uid);
    }

    // Cópia dos horários da cliente ("Meus horários").
    match /clientes/{cid}/agendamentos/{id} {
      allow read, create: if dono(cid);
      allow delete: if dono(cid) || (logado() && resource.data.profissionalId == request.auth.uid);
      allow update: if false;
    }

    // ===== Chat profissional <-> cliente =====
    function participante(dados) {
      return logado() && request.auth.uid in dados.participantes;
    }

    match /conversas/{conversaId} {
      // resource == null: conversa ainda não existe (o app confere antes de
      // criar). Sem isso, abrir o chat pela primeira vez dava PERMISSION_DENIED.
      allow read: if logado() && (resource == null || request.auth.uid in resource.data.participantes);
      // Id fixo profissionalId_clienteId; ninguém conversa consigo mesmo.
      allow create: if participante(request.resource.data)
        && request.resource.data.participantes == [request.resource.data.profissionalId, request.resource.data.clienteId]
        && request.resource.data.profissionalId != request.resource.data.clienteId
        && conversaId == request.resource.data.profissionalId + '_' + request.resource.data.clienteId
        && exists(/databases/$(database)/documents/profissionais/$(request.resource.data.profissionalId));
      // Só o resumo muda (última mensagem, contadores, nomes/foto) e o
      // "apagar só para mim" (cada um mexe só na própria chave de apagadaPara).
      allow update: if participante(resource.data)
        && alterados().hasOnly(['ultimaMensagem', 'ultimoTimestamp', 'ultimoRemetenteId',
                                'naoLidasProfissional', 'naoLidasCliente',
                                'profissionalNome', 'profissionalFotoUrl', 'clienteNome',
                                'apagadaPara'])
        && (!alterados().hasAny(['apagadaPara'])
          || request.resource.data.apagadaPara.diff(resource.data.get('apagadaPara', {})).affectedKeys().hasOnly([request.auth.uid]));
      // "Apagar para todos": qualquer uma das duas pessoas (as mensagens
      // são apagadas antes, ver mensagens abaixo).
      allow delete: if participante(resource.data);

      match /mensagens/{mensagemId} {
        function conversa() {
          return get(/databases/$(database)/documents/conversas/$(conversaId)).data;
        }
        allow read: if participante(conversa());
        allow create: if participante(conversa())
          && request.resource.data.remetenteId == request.auth.uid
          && request.resource.data.destinatarioId in conversa().participantes
          && request.resource.data.destinatarioId != request.auth.uid
          && request.resource.data.conteudo is string
          && request.resource.data.conteudo.size() > 0
          && request.resource.data.conteudo.size() <= 2000
          && request.resource.data.lida == false;
        allow update: if
          // Só quem recebeu marca como lida.
          (logado() && resource.data.destinatarioId == request.auth.uid
            && alterados().hasOnly(['lida']))
          // Apagar para mim: só acrescenta o próprio uid em ocultaPara.
          || (participante(conversa())
            && alterados().hasOnly(['ocultaPara'])
            && request.resource.data.ocultaPara.toSet().difference(resource.data.get('ocultaPara', []).toSet()).hasOnly([request.auth.uid])
            && resource.data.get('ocultaPara', []).toSet().difference(request.resource.data.ocultaPara.toSet()).size() == 0)
          // Apagar para todos: só quem mandou; o texto vira vazio.
          || (resource.data.remetenteId == request.auth.uid
            && participante(conversa())
            && alterados().hasOnly(['apagada', 'conteudo'])
            && request.resource.data.apagada == true
            && request.resource.data.conteudo == '');
        // Apagar a conversa para todos leva as mensagens junto.
        allow delete: if participante(conversa());
      }
    }

    // Token de push do aparelho (uma pessoa pode ser profissional e cliente).
    match /dispositivos/{uid} {
      allow read, write: if dono(uid);
    }

    // ===== Clientes =====
    match /clientes/{uid} {
      allow read: if dono(uid) || (ehAdmin() && permissaoAdmin('clientes'));
      allow create: if dono(uid) && request.resource.data.bloqueado == false;
      allow update: if (dono(uid) && !alterados().hasAny(['bloqueado', 'email', 'criadoEm']))
        || (ehAdmin() && permissaoAdmin('clientes') && alterados().hasOnly(['bloqueado']));
      allow delete: if false;
    }

    // ===== Administradores =====
    match /admins/{uid} {
      allow read: if dono(uid) || ehAdmin();
      // Só a foto, pelo próprio admin. Criar/excluir: só Cloud Function.
      allow update: if dono(uid) && alterados().hasOnly(['fotoUrl']);
      allow create, delete: if false;
    }

    match /logsAdministracao/{id} {
      allow read: if ehAdmin() && permissaoAdmin('administradores');
      allow write: if false;
    }
  }
}
